export EDITOR="nvim"
export VISUAL="nvim"

eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="$HOME/.docker/bin:$PATH"

# Prefer Homebrew Ruby over the macOS system Ruby when it's installed.
# Ruby is keg-only, so Homebrew won't put it on the PATH automatically.
if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
  # Add gem-installed binaries; glob the version dir so it survives Ruby upgrades.
  for gem_bin in /opt/homebrew/lib/ruby/gems/*/bin(N); do
    export PATH="$gem_bin:$PATH"
  done
  export LDFLAGS="-L/opt/homebrew/opt/ruby/lib"
  export CPPFLAGS="-I/opt/homebrew/opt/ruby/include"
fi

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/jay/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions

export COLORTERM=truecolor

bindkey -e  # Use emacs key bindings (includes Ctrl-R for history search)

eval "$(starship init zsh)"
export PATH="$HOME/.local/bin:$PATH"
